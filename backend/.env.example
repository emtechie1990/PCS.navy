# Which site this deployment is: army | navy | airforce
BRAND=navy

MONGO_URL="mongodb://localhost:27017"
DB_NAME="pcs_navy"
# Comma-separated explicit browser origins. Do not use * with session cookies.
CORS_ORIGINS="https://pcs.army,https://www.pcs.army"

# Public URL + allow-listed hosts for password-reset links
APP_URL=https://pcs.navy
SITE_HOSTS="pcs.navy,www.pcs.navy"

# Resend (https://resend.com) — transactional email for password resets
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=no-reply@pcs.navy
EMAIL_FROM_NAME="PCS.navy"
EMAIL_REPLY_TO=

# Payments: a provider is live as soon as its keys are set (Stripe: card, Apple Pay, Google Pay, Cash App; PayPal: PayPal, Venmo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live

# Owner admin, created on first boot
ADMIN_EMAIL=prescottmanisela@gmail.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME
